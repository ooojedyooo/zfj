/* app.wxss · 全局样式与设计变量 */

page {
  /* 主色 */
  --c-primary: #185FA5;
  --c-primary-light: #E6F1FB;
  --c-primary-dark: #0C447C;

  /* 命中相关：红=被击中/击毁，橙=我方命中 */
  --c-danger: #E24B4A;
  --c-danger-light: #FCEBEB;
  --c-danger-dark: #791F1F;
  --c-hit: #EF9F27;
  --c-hit-light: #FAEEDA;

  /* 中性 */
  --c-bg: #F6F7F9;
  --c-card: #FFFFFF;
  --c-border: #E6E8EB;
  --c-border-strong: #B4B2A9;
  --c-text: #1F2328;
  --c-text-muted: #6B7280;
  --c-gray: #F1EFE8;
  --c-gray-strong: #E5E2DA;

  /* 棋盘 */
  --c-plane: #B5D4F4;
  --c-plane-body: #378ADD;

  background: var(--c-bg);
  color: var(--c-text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ---------- 通用容器 ---------- */
.page-wrap {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--c-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--c-border);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--c-text-muted);
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  margin-bottom: 20rpx;
}

.btn::after { border: none; }

.btn-primary {
  background: var(--c-primary);
  color: #FFFFFF;
}

.btn-outline {
  background: var(--c-primary-light);
  color: var(--c-primary-dark);
  border: 1rpx solid var(--c-primary);
}

.btn-danger {
  background: var(--c-danger-light);
  color: var(--c-danger-dark);
  border: 1rpx solid var(--c-danger);
}

.btn[disabled] {
  opacity: 0.45;
}

/* ---------- 文本 ---------- */
.muted { color: var(--c-text-muted); font-size: 26rpx; }
.danger { color: var(--c-danger); }
.strong { font-weight: 600; }
.center { text-align: center; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  background: var(--c-primary-light);
  color: var(--c-primary-dark);
}
