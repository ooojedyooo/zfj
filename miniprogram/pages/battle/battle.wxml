<view class="page-wrap battle">

  <view class="status-bar">
    <view class="status-text {{myTurn ? 'active' : ''}}">{{statusText}}</view>
    <view class="shots">
      <text>我方 {{myShots}} · 对方 {{foeShots}}</text>
      <text wx:if="{{!finished}}" class="cd">· {{turnSeconds}}s</text>
    </view>
  </view>

  <view wx:if="{{!isCloud}}" class="mode-tip">离线试玩模式 · 对手由本地 AI 扮演</view>

  <!-- 我方海域 -->
  <view class="area {{focus === 'mine' ? 'focused' : 'dimmed'}}" bindtap="focusMine">
    <view class="area-title">
      <text>我方海域 · 受损情况</text>
      <text wx:if="{{focus === 'mine'}}" class="tag">焦点</text>
    </view>
    <board-grid cells="{{myCells}}" size="{{size}}" selectable="{{false}}" />
  </view>

  <!-- 敌方海域 -->
  <view class="area {{focus === 'foe' ? 'focused' : 'dimmed'}}" bindtap="focusFoe">
    <view class="area-title">
      <text>敌方海域 · 我方战况</text>
      <text wx:if="{{focus === 'foe'}}" class="tag">焦点</text>
    </view>
    <board-grid
      cells="{{foeCells}}"
      size="{{size}}"
      selectable="{{myTurn && !finished}}"
      selected="{{selected}}"
      disabledMap="{{foeDisabled}}"
      bindcelltap="onFoeCellTap"
    />
  </view>

  <!-- 出招区 -->
  <view class="fire-bar">
    <view class="coord">
      {{selected ? '横' + selected.col + '，竖' + selected.row : '请选择轰炸坐标'}}
    </view>
    <view class="emoji-toggle {{emoteBarOpen ? 'on' : ''}}" bindtap="onToggleEmote">😀</view>
    <button class="btn btn-primary fire-btn" bindtap="onFire">发射</button>
  </view>

  <!-- 快捷表情栏 -->
  <view wx:if="{{emoteBarOpen}}" class="emote-bar">
    <view
      wx:for="{{emotes}}"
      wx:key="emoji"
      class="emote-item"
      data-emoji="{{item.emoji}}"
      bindtap="onSendEmote"
    >{{item.emoji}}</view>
  </view>

  <view class="bottom-row">
    <button class="btn btn-danger surrender" bindtap="onSurrender">投降</button>
    <button class="btn btn-outline share-btn" open-type="share">邀请好友</button>
  </view>

  <!-- 表情气泡 -->
  <view wx:if="{{emoteBubble}}" class="emote-bubble {{emoteBubble.mine ? 'mine' : 'foe'}}">
    <text class="emote-bubble-who">{{emoteBubble.mine ? '你' : '对方'}}</text>
    <text class="emote-bubble-emoji">{{emoteBubble.emoji}}</text>
  </view>

  <!-- 命中反馈 -->
  <view wx:if="{{resultToast}}" class="result-toast">{{resultToast}}</view>

</view>
