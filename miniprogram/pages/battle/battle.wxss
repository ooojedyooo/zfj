/* pages/battle/battle.wxss */
.battle {
  padding-bottom: 40rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 28rpx;
  color: var(--c-text-muted);
}

.status-text.active {
  color: var(--c-primary);
  font-weight: 600;
}

.shots {
  font-size: 24rpx;
  color: var(--c-text-muted);
}

.shots .cd {
  color: var(--c-primary);
  font-weight: 600;
}

.area {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid transparent;
  transition: opacity 0.2s, border-color 0.2s;
}

.area.focused {
  border-color: var(--c-primary);
}

.area.dimmed {
  opacity: 0.55;
}

.area-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.fire-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.coord {
  flex: 1;
  font-size: 30rpx;
  color: var(--c-text-muted);
  padding: 0 8rpx;
}

.emoji-toggle {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  border-radius: 16rpx;
  background: var(--c-gray);
  border: 2rpx solid transparent;
}

.emoji-toggle.on {
  border-color: var(--c-primary);
  background: var(--c-primary-light);
}

.fire-btn {
  width: 200rpx;
  margin-bottom: 0;
}

/* 快捷表情栏 */
.emote-bar {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.emote-item {
  flex: 1;
  text-align: center;
  font-size: 46rpx;
  line-height: 1.4;
  border-radius: 14rpx;
  background: var(--c-gray);
}

.emote-item:active {
  background: var(--c-primary-light);
}

/* 表情气泡 */
.emote-bubble {
  position: fixed;
  top: 22%;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  animation: pop 0.18s ease-out;
}

.emote-bubble.mine {
  right: 32rpx;
}

.emote-bubble.foe {
  left: 32rpx;
}

.emote-bubble-who {
  font-size: 24rpx;
  color: var(--c-text-muted);
}

.emote-bubble-emoji {
  font-size: 52rpx;
  line-height: 1;
}

@keyframes pop {
  from { transform: scale(0.7); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.bottom-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.surrender {
  flex: 1;
  margin-top: 0;
  height: 72rpx;
  font-size: 26rpx;
}

.share-btn {
  flex: 1;
  margin-top: 0;
  height: 72rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.mode-tip {
  font-size: 22rpx;
  color: var(--c-text-muted);
  background: var(--c-gray);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 16rpx;
}

.result-toast {
  position: fixed;
  left: 50%;
  top: 40%;
  transform: translate(-50%, -50%);
  background: rgba(12, 68, 124, 0.92);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 600;
  padding: 32rpx 64rpx;
  border-radius: 20rpx;
}
