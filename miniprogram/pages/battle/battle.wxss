/* pages/battle/battle.wxss */
.battle {
  padding-bottom: 40rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 28rpx;
  color: var(--c-text-muted);
}

.status-text.active {
  color: var(--c-primary);
  font-weight: 600;
}

.shots {
  font-size: 24rpx;
  color: var(--c-text-muted);
}

.shots .cd {
  color: var(--c-primary);
  font-weight: 600;
}

.area {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid transparent;
  transition: opacity 0.2s, border-color 0.2s;
}

.area.focused {
  border-color: var(--c-primary);
}

.area.dimmed {
  opacity: 0.55;
}

.area-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.fire-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.coord {
  flex: 1;
  font-size: 30rpx;
  color: var(--c-text-muted);
  padding: 0 8rpx;
}

.fire-btn {
  width: 220rpx;
  margin-bottom: 0;
}

.surrender {
  margin-top: 20rpx;
  height: 72rpx;
  font-size: 26rpx;
}

.result-toast {
  position: fixed;
  left: 50%;
  top: 40%;
  transform: translate(-50%, -50%);
  background: rgba(12, 68, 124, 0.92);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 600;
  padding: 32rpx 64rpx;
  border-radius: 20rpx;
}
