/* pages/deploy/deploy.wxss */
.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip {
  font-size: 26rpx;
  color: var(--c-text-muted);
}

.countdown {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-primary);
}

.countdown.urgent {
  color: var(--c-danger);
}

.board-wrap {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--c-border);
}

.row:last-child {
  border-bottom: none;
}

.ops {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.op {
  flex: 1;
  margin-bottom: 0;
  font-size: 26rpx;
}
