<view class="page-wrap">

  <!-- 创建房间 -->
  <block wx:if="{{mode === 'create'}}">
    <view class="card">
      <view class="section-title">房间设置</view>

      <view class="row">
        <text>飞机数量</text>
        <view class="stepper">
          <view class="stepper-btn" bindtap="decPlane">−</view>
          <text class="stepper-val">{{planeCount}}</text>
          <view class="stepper-btn" bindtap="incPlane">＋</view>
        </view>
      </view>

      <view class="row">
        <text>设置密码</text>
        <switch checked="{{usePassword}}" color="#185FA5" bindchange="togglePassword" />
      </view>

      <view wx:if="{{usePassword}}" class="pwd-box">
        <text class="muted">房间密码</text>
        <text class="pwd">{{password}}</text>
      </view>
    </view>

    <button class="btn btn-primary" bindtap="onWait">生成房间并等待对手</button>
  </block>

  <!-- 加入房间 -->
  <block wx:elif="{{mode === 'join'}}">
    <view class="card">
      <view class="section-title">加入房间</view>
      <view class="field">
        <text class="field-label">房间号</text>
        <input type="number" maxlength="6" placeholder="请输入 6 位房间号"
               value="{{joinRoomId}}" bindinput="onJoinRoomIdInput" />
      </view>
      <view class="field">
        <text class="field-label">密码（如无请留空）</text>
        <input type="number" maxlength="4" placeholder="4 位数字密码"
               value="{{joinPassword}}" bindinput="onJoinPasswordInput" />
      </view>
    </view>
    <button class="btn btn-primary" bindtap="onJoin">加入房间</button>
  </block>

  <!-- 等待对手（含随机匹配） -->
  <block wx:else>
    <view class="card center">
      <view class="section-title">
        {{mode === 'random' ? '正在匹配对手…' : '等待对手加入'}}
      </view>
      <view wx:if="{{roomId}}" class="room-id">
        <text class="muted">房间号</text>
        <text class="room-id-num">{{roomId}}</text>
      </view>
      <view class="loading-ring"></view>
      <view class="muted">超时将在 {{waitSeconds}} 秒后自动解散</view>
    </view>
    <button class="btn btn-outline" bindtap="onCancel">取消</button>
  </block>

</view>
